{
    "name": "icon.gl",
    "description": "icon.gl is a icon library and framework developed by Scape Press.",
    "version": "0.0.45",
    "config": {
        "version_short": "0.0"
    },
    "keywords": [
        "icon.gl",
        "stylescape",
        "icon",
        "icons",
        "icon-library",
        "font",
        "sprite",
        "svg",
        "sass",
        "scss",
        "woff",
        "woff2",
        "responsive",
        "front-end",
        "framework",
        "web"
    ],
    "homepage": "https://www.icon.gl/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Press"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/icon.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/icon.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "./dist/js/index.cjs",
    "module": "./dist/js/index.mjs",
    "types": "./dist/js/index.d.ts",
    "sass": "src/scss/index.scss",
    "style": "dist/css/icon.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.yml && npm run build:ts",
        "build:ts": "npm run build:js && npm run build:dts",
        "build:js": "tsup",
        "build:dts": "NODE_OPTIONS=--max-old-space-size=4096 tsc --declaration --emitDeclarationOnly --outDir dist/js --skipLibCheck",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "format": "npx prettier --write .",
        "lint": "eslint 'src/**/*.ts' || true"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@getkist/action-fantasticon": "^0.1.17",
        "@getkist/action-nunjucks": "^2.0.28",
        "@getkist/action-sass": "^1.0.23",
        "@getkist/action-svg": "^1.0.24",
        "@getkist/action-terser": "^1.0.23",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^26.4.0",
        "@vitest/coverage-v8": "^4.1.5",
        "@vitest/ui": "^4.1.5",
        "fantasticon": "^4.1.0",
        "happy-dom": "^20.11.6",
        "jsdom": "^29.0.1",
        "kist": "^0.1.77",
        "sass": "^1.103.0",
        "ts-node": "^10.9.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./src/scss/index.scss",
            "types": "./dist/js/index.d.ts",
            "import": "./dist/js/index.mjs",
            "require": "./dist/js/index.cjs"
        },
        "./scss": "./dist/scss/index.scss",
        "./css/icon.gl.css": "./dist/css/icon.gl.css",
        "./css/icon.gl.min.css": "./dist/css/icon.gl.min.css"
    },
    "overrides": {
        "@xmldom/xmldom": "^0.9.10",
        "tar": "^7.5.13",
        "@tootallnate/once": "^3.0.1"
    }
}
