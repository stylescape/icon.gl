{
    "name": "icon.gl",
    "description": "icon.gl is a icon library and framework developed by Scape Agency.",
    "version": "0.0.35",
    "config": {
        "version_short": "0.0"
    },
    "keywords": [
        "icon.gl",
        "stylescape",
        "icon",
        "icons",
        "icon-library",
        "font",
        "sprite",
        "svg",
        "sass",
        "scss",
        "woff",
        "woff2",
        "responsive",
        "front-end",
        "framework",
        "web"
    ],
    "homepage": "https://www.icon.gl/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Agency"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/scape-agency/icon.gl.git"
    },
    "bugs": {
        "url": "https://github.com/scape-agency/icon.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/icon.gl.js",
    "style": "dist/css/icon.gl.css",
    "scripts": {
        "build": "npm run build-compile && npm run build-process && npm run kist-build",
        "build-compile": "tsc -p bin/tsconfig.json",
        "build-process": "node bin/js/index.js",
        "kist-build": "npx kist --config ./kist.yml",
        "kist-watch": "npx kist --config ./kist.yml --live",
        "dev": "vite",
        "format": "npx prettier --write .",
        "lint": "eslint 'src/**/*.ts' || true",
        "prettify": "prettier --write 'src/**/*.ts'",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@getkist/action-nunjucks": "^2.0.9",
        "@getkist/action-sass": "^1.0.4",
        "tslib": "^2.8.1",
        "vite": "^7.3.1"
    },
    "devDependencies": {
        "@babel/core": "^7.23.6",
        "@babel/preset-env": "^7.23.6",
        "@babel/preset-typescript": "^7.23.3",
        "@getkist/action-svg": "^1.0.4",
        "@getkist/action-terser": "^1.0.2",
        "@testing-library/dom": "^10.4.1",
        "@types/node": "^25.0.10",
        "@vitest/coverage-v8": "^4.0.16",
        "@vitest/ui": "^4.0.16",
        "happy-dom": "^20.0.11",
        "jsdom": "^27.3.0",
        "kist": "^0.1.60",
        "sass": "^1.97.3",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.3",
        "vitest": "^4.0.16"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "typescript": "./ts/index.ts"
        }
    }
}
