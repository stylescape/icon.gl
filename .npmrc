# =============================================================================
# NPM Configuration
# =============================================================================
#
# npm: Node.js package manager configuration
# Documentation: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc
#
# -----------------------------------------------------------------------------
# Configuration Hierarchy (highest to lowest priority)
# -----------------------------------------------------------------------------
#
#   1. Command line flags:      --save-exact
#   2. Environment variables:   npm_config_save_exact=true
#   3. Project .npmrc:          This file (committed to repo)
#   4. User ~/.npmrc:           Per-user settings (auth tokens)
#   5. Global /etc/npmrc:       System-wide defaults
#
# -----------------------------------------------------------------------------
# Usage
# -----------------------------------------------------------------------------
#
#   Install dependencies:
#     npm install
#
#   Add package:
#     npm install <package>
#
#   Security audit:
#     npm audit
#
#   Update packages:
#     npm update
#
#   Clean install (CI):
#     npm ci
#
# =============================================================================


# =============================================================================
# Lockfile Behavior
# =============================================================================
#
# package-lock:
#   true  = Generate/update package-lock.json (recommended)
#   false = Never create or update lockfile
#
# -----------------------------------------------------------------------------

package-lock=true


# =============================================================================
# Engine Compatibility
# =============================================================================
#
# engine-strict:
#   true  = Fail install if Node/npm version doesn't match engines field
#   false = Only warn about version mismatches
#
# Ensures consistent environments across development and CI.
#
# -----------------------------------------------------------------------------

engine-strict=true


# =============================================================================
# Version Pinning
# =============================================================================
#
# save-exact:
#   true  = Save exact versions: "lodash": "4.17.21"
#   false = Save with caret:    "lodash": "^4.17.21" (allows minor updates)
#
# We use false to allow minor/patch updates via npm update.
# The lockfile ensures reproducible builds regardless.
#
# -----------------------------------------------------------------------------

save-exact=false


# =============================================================================
# Security & Auditing
# =============================================================================
#
# audit:
#   true  = Run vulnerability scan on install
#   false = Skip audit (faster but less secure)
#
# strict-ssl:
#   true  = Require valid SSL certificates
#   false = Allow self-signed (dangerous, avoid)
#
# -----------------------------------------------------------------------------

audit=true
strict-ssl=true


# =============================================================================
# Output & Notifications
# =============================================================================
#
# fund:
#   true  = Show funding messages for packages
#   false = Suppress funding reminders
#
# update-notifier:
#   true  = Notify when npm update is available
#   false = Suppress update notifications
#
# loglevel:
#   silent, error, warn, notice, http, info, verbose, silly
#
# progress:
#   true  = Show progress bar during install
#   false = Disable (cleaner CI output)
#
# -----------------------------------------------------------------------------

fund=false
update-notifier=false
loglevel=warn

; Uncomment to disable progress bar in CI:
; progress=false


# =============================================================================
# Network & Caching
# =============================================================================
#
# prefer-offline:
#   true  = Use cache when available, fallback to network
#   false = Always fetch from registry
#
# fetch-retries:
#   Number of retry attempts for failed network requests
#
# fetch-retry-mintimeout:
#   Minimum wait time (ms) between retries
#
# fetch-retry-maxtimeout:
#   Maximum wait time (ms) between retries (exponential backoff)
#
# -----------------------------------------------------------------------------

prefer-offline=true
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000


# =============================================================================
# Peer Dependencies
# =============================================================================
#
# legacy-peer-deps:
#   true  = Ignore peer dependency conflicts (npm 6 behavior)
#   false = Strict peer dependency resolution (npm 7+ default)
#
# Only enable if you encounter unresolvable peer conflicts.
#
# -----------------------------------------------------------------------------

; legacy-peer-deps=true


# =============================================================================
# Security: Script Execution
# =============================================================================
#
# ignore-scripts:
#   true  = Skip preinstall/postinstall scripts (more secure)
#   false = Run lifecycle scripts (required for many packages)
#
# Enable for security-sensitive environments or untrusted packages.
#
# -----------------------------------------------------------------------------

; ignore-scripts=true


# =============================================================================
# Registry Configuration
# =============================================================================
#
# By default, npm uses https://registry.npmjs.org/
#
# To use GitHub Packages for scoped packages (@starling-cloud/*):
#   1. Uncomment the lines below
#   2. Set GITHUB_TOKEN environment variable or add to ~/.npmrc:
#      //npm.pkg.github.com/:_authToken=ghp_xxxxxxxxxxxx
#
# SECURITY: Never commit auth tokens to this file!
# Store tokens in user-level ~/.npmrc or environment variables.
#
# -----------------------------------------------------------------------------

; @starling-cloud:registry=https://npm.pkg.github.com
; //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
