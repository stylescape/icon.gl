{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_workflows.py",
            "timeout": 10,
            "statusMessage": "CI policy guard"
          }
        ]
      }
    ]
  }
}
